# Optional fixed Worker URL (Cloudflare deploy or forced host).
# Production (Cloudflare): set before `bun run build`, e.g. wss://radioboi-worker....workers.dev
# LAN / offline: leave unset so the client uses the page hostname + WS port.
# NEXT_PUBLIC_WS_URL=wss://your-worker.example.com

# Used when NEXT_PUBLIC_WS_URL is unset (LAN / offline / dynamic host).
NEXT_PUBLIC_WS_PORT=8787
